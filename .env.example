# Copy to .env and fill in. .env is gitignored — never commit real values.

# ─── ENSv2 / Sepolia (Phase 1) ───────────────────────────────────────────────
# The chain scripts read SEPOLIA_RPC_URL (server-side only, so no NEXT_PUBLIC_).
# Alchemy: alchemy.com -> Create app -> Ethereum / Sepolia -> copy the HTTPS URL
SEPOLIA_RPC_URL=

# Signer for all on-chain scripts. Provide ONE of the two; PRIVATE_KEY wins when
# both are set. Use a dedicated testnet burner wallet, never a funded one.
PRIVATE_KEY=
# MNEMONIC=

# 32 random bytes for the ENS commit-reveal registration flow. Generate once and
# keep it: the commit and register steps must use the same value, so changing it
# mid-flow orphans the commitment and you wait out the timeout.
#   node -e "console.log('0x'+require('crypto').randomBytes(32).toString('hex'))"
REGISTRATION_SECRET=

# ─── Phase 1 outputs — leave blank, filled in after the scripts run ──────────
# Printed by `npm run register:identity`
AGENT_ID=
# Set by `npm run register:ens`
ENS_NAME=testagent.mandate.eth
AGENT_ENS_NAME=testagent.mandate.eth
# The agent's execution wallet (the signer address is fine for the prototype)
AGENT_ADDRESS=
# Does not exist until PermissionMirror is deployed in Phase 7
PERMISSION_MIRROR_ADDRESS=

# ─── The Graph (Phase 3) ─────────────────────────────────────────────────────
# thegraph.com/studio -> API Keys
NEXT_PUBLIC_GRAPH_API_KEY=
# Agent0 / ERC-8004 subgraph (Base Mainnet deployment)
NEXT_PUBLIC_AGENT0_SUBGRAPH_ID=43s9hQRurMGjuYnC1r2ZwS6xSQktbFyXMPMqGKUFJojb
# Our own subgraph, after deploying it to Subgraph Studio
NEXT_PUBLIC_MANDATE_SUBGRAPH_ID=

# ─── Circle / Arc (Phase 5) ──────────────────────────────────────────────────
# console.circle.com -> API Keys
CIRCLE_API_KEY=
CIRCLE_ENTITY_SECRET=
NEXT_PUBLIC_CIRCLE_ENVIRONMENT=testnet

# ─── 1inch (Phase 7, stretch) ────────────────────────────────────────────────
# portal.1inch.dev -> Dashboard
ONEINCH_API_KEY=

# ─── MCP Server (Phase 3) ────────────────────────────────────────────────────
MCP_SERVER_PORT=3001
