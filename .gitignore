# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
Thumbs.db
desktop.ini
*:Zone.Identifier
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (.env.example is intentionally committed as a template)
.env
.env.local
.env.*.local

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

# bun.lock: repo standardises on npm (package-lock.json); ignored so an
# occasional `bun install` doesn't dirty the tree or drift from the real lockfile
bun.lock

# subgraph build artifacts
/subgraph/build
/subgraph/generated
/subgraph/node_modules

# foundry build output
/out
/cache
